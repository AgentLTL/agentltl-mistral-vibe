# Copy to .env (gitignored). Used only by docker/ to try the plugin on your own model.
# docker --env-file takes each line as is: no quotes, no comments after a value.
#
# An OpenAI-compatible server (/v1 is added if missing), and its key (empty for none):
VLLM_BASE_URL=http://host:8000/v1
VLLM_API_KEY=
# Optional: a served model name (GET /v1/models), its context, and the field the server
# puts reasoning in (vLLM: reasoning or reasoning_content).
# VLLM_MODEL=qwen3.8-27b
# VLLM_MAX_CONTEXT=65536
# VLLM_REASONING_FIELD=reasoning
